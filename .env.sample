# SQLBot 环境变量样例（复制为 .env 后按需修改）
# 后端从 ../.env（backend/ 上一级，即仓库根）读取配置

# 安全密钥（生产环境务必改为随机值）
SECRET_KEY=change-me-to-a-random-secret-key

# 默认密码 / 登录
DEFAULT_PWD=SQLBot@123456
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# CORS
# BACKEND_CORS_ORIGINS=http://localhost:5173

# 日志
LOG_LEVEL=INFO
SQL_DEBUG=False

# 缓存：redis / memory / None
CACHE_TYPE=memory
# CACHE_REDIS_URL=redis://localhost:6379/0

# 数据库（内置 postgres 时用镜像内的 POSTGRES_DB/USER/PASSWORD 默认值即可）
# 如需连接外部数据库，设置 SQLBOT_DB_URL 覆盖（支持 MySQL）
# SQLBOT_DB_URL=mysql+pymysql://root:password@127.0.0.1:3306/sqlbot

# 图片/MCP 服务
SERVER_IMAGE_HOST=http://localhost:8001/images/

# 上下文路径（如需子路径部署，如 /sqlbot）
# CONTEXT_PATH=/sqlbot

# Docker 端口（供根目录 docker-compose.yml 使用）
SQLBOT_WEB_PORT=8000
SQLBOT_MCP_PORT=8001
