{
  "_说明": "组合指标。引用 erp_metrics.json 中的基础指标。公式中的指标名必须与基础指标名完全一致。",

  "metrics": {
    "毛利润": {
      "aliases": ["利润", "毛利", "profit"],
      "description": "有效订单收入减去采购成本",
      "formula": "有效订单收入 - 采购成本",
      "unit": "元",
      "dependencies": ["有效订单收入", "采购成本"]
    },

    "毛利率": {
      "aliases": ["利润率", "毛利比", "margin"],
      "description": "毛利润占有效订单收入的比例",
      "formula": "(毛利润 / NULLIF(有效订单收入, 0)) * 100",
      "unit": "%",
      "dependencies": ["毛利润", "有效订单收入"]
    },

    "净利润": {
      "aliases": ["净利", "net profit", "纯利润"],
      "description": "收入减去所有费用（采购+物流+关税+平台+支付+广告+退货+其他）",
      "formula": "有效订单收入 - 采购成本 - 头程运费 - 关税 - 尾程配送费 - 平台费 - 支付手续费 - 广告费 - 退货成本 - 其他成本",
      "unit": "元",
      "dependencies": ["有效订单收入", "采购成本", "头程运费", "关税", "尾程配送费", "平台费", "支付手续费", "广告费", "退货成本", "其他成本"]
    },

    "净利润率": {
      "aliases": ["净利率", "纯利润率", "net margin"],
      "formula": "(净利润 / NULLIF(有效订单收入, 0)) * 100",
      "unit": "%",
      "dependencies": ["净利润", "有效订单收入"]
    },

    "客单价": {
      "aliases": ["平均订单金额", "AOV", "笔单价"],
      "formula": "有效订单收入 / NULLIF(有效订单数, 0)",
      "unit": "元",
      "dependencies": ["有效订单收入", "有效订单数"]
    },

    "件单价": {
      "aliases": ["平均单价", "ASP"],
      "formula": "有效订单收入 / NULLIF(销量, 0)",
      "unit": "元",
      "dependencies": ["有效订单收入", "销量"]
    },

    "单均利润": {
      "aliases": ["平均每单利润"],
      "formula": "净利润 / NULLIF(有效订单数, 0)",
      "unit": "元",
      "dependencies": ["净利润", "有效订单数"]
    }
  }
}
